---
import { render } from "astro:content";
import { getSortedBlogs } from "../../utils/content";

export const getStaticPaths = async () => {
  const blogs = await getSortedBlogs();
  return blogs.map((blog, index) => ({
    params: { slug: blog.id },
    props: {
      blog,
      previousBlog: index > 0 ? blogs[index - 1] : null,
      nextBlog: index < blogs.length - 1 ? blogs[index + 1] : null,
    },
  }));
};

const { blog, previousBlog, nextBlog } = Astro.props;

const { Content } = await render(blog);
---

<Content />

{
  previousBlog && (
    <a
      href={`/blogs/${previousBlog.id}`}
      aria-label={`Previous blog: ${previousBlog.data.title}`}
    >
      Previous
      {previousBlog.data.title}
    </a>
  )
}
{
  nextBlog && (
    <a
      href={`/blogs/${nextBlog.id}`}
      aria-label={`Next blog: ${nextBlog.data.title}`}
    >
      Next
      {nextBlog.data.title}
    </a>
  )
}
