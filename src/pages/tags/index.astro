---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getUniqueTags } from "../../utils/content";

const tags = await getUniqueTags();
---

<BaseLayout title="Tags">
  <h1
    class="mb-8 text-lg font-semibold tracking-widest text-neutral-900 uppercase"
  >
    Tags
  </h1>
  <ul class="flex flex-wrap gap-x-5 gap-y-3">
    {
      tags.map((tag: string) => (
        <li>
          <a
            href={`/tags/${tag}`}
            class="text-neutral-600 underline decoration-neutral-200 underline-offset-4 transition-colors hover:text-neutral-900 hover:decoration-neutral-900"
          >
            #{tag}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
