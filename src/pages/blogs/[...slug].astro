---
import { render } from "astro:content";
import { getSortedBlogs } from "../../utils/content";
import BlogNavigation from "../../components/BlogNavigation.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = async () => {
  const blogs = await getSortedBlogs();
  return blogs.map((blog, index) => ({
    params: { slug: blog.id },
    props: {
      blog,
      previousBlog: index > 0 ? blogs[index - 1] : null,
      nextBlog: index < blogs.length - 1 ? blogs[index + 1] : null,
    },
  }));
};

const { blog, previousBlog, nextBlog } = Astro.props;
const { Content } = await render(blog);
---

<BaseLayout title={blog.data.title}>
  <header class="mb-10 space-y-3">
    <h1 class="text-base font-medium text-neutral-900">{blog.data.title}</h1>
    <p class="text-sm leading-relaxed text-neutral-400">
      {blog.data.description}
    </p>
    <div class="flex items-center gap-4">
      <time class="text-xs text-neutral-400">
        {
          blog.data.publishedDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
      {
        blog.data.tags.length > 0 && (
          <div class="flex gap-2">
            {blog.data.tags.map(tag => (
              <a
                href={`/tags/${tag}`}
                class="text-xs text-neutral-400 transition-colors hover:text-neutral-900"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </header>

  <div class="prose">
    <Content />
  </div>

  <BlogNavigation previousBlog={previousBlog} nextBlog={nextBlog} />
</BaseLayout>
