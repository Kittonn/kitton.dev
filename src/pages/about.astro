---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import avatar from "../assets/avatar.jpg";
import { Icon } from "astro-icon/components";
import { config } from "../config";
import { formatPeriod } from "../utils/date";
import { experiences } from "../data/experience";
import { educations } from "../data/education";
---

<BaseLayout title="About">
  <section class="flex flex-col items-start gap-6 sm:flex-row sm:gap-10">
    <Picture
      src={avatar}
      formats={["avif", "webp"]}
      alt="Kittipod Lambangchang"
      width={400}
      height={500}
      loading="eager"
      fetchpriority="high"
      class="aspect-3/4 w-48 shrink-0 rounded-md object-cover"
    />

    <div class="flex flex-1 flex-col gap-4">
      <div class="space-y-1">
        <p class="text-xs tracking-widest text-neutral-400 uppercase">About</p>
        <h1 class="text-2xl font-semibold text-neutral-900 sm:text-3xl">
          Kittipod Lambangchang
        </h1>
        <p class="text-sm text-neutral-400">
          aka Kitton <span class="mx-1.5">·</span> Software Engineer
        </p>
      </div>

      <div class="space-y-3 leading-relaxed text-neutral-500">
        <p>
          I'm a Software Engineer working in fintech, passionate about building
          scalable systems, designing reliable software, and exploring new
          technologies.
        </p>
        <p>
          I enjoy writing about things I learn along the way — whether it's a
          new tool, a pattern that clicked, or a problem worth sharing.
        </p>
      </div>

      <div class="flex items-center gap-3">
        {
          config.contacts.map(contact => (
            <a
              href={contact.href}
              class="text-neutral-400 transition-colors hover:text-neutral-900"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={contact.label}
            >
              <Icon name={contact.icon} class="size-5" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="mb-8 text-sm tracking-widest text-neutral-400 uppercase">
      Experience
    </h2>

    <ul class="space-y-10">
      {
        experiences.map((item, index) => (
          <li class="relative flex items-start gap-4">
            <div
              class={`absolute left-5.5 w-px bg-neutral-200${index < experiences.length - 1 ? " top-0 -bottom-10" : " top-0 h-6"}`}
            />

            <Picture
              src={item.logo}
              formats={["avif", "webp"]}
              alt={item.company}
              width={44}
              height={44}
              class="relative z-10 mt-0.5 size-11 shrink-0 rounded-xl object-contain ring-1 ring-neutral-200"
            />

            <div class="flex-1">
              <div class="sm:flex sm:items-start sm:justify-between sm:gap-4">
                <div>
                  <p class="font-semibold text-neutral-900">{item.role}</p>
                  <p class="mt-0.5 text-sm font-medium text-neutral-700">
                    {item.company}
                  </p>
                </div>
                <span class="mt-0.5 block text-sm text-neutral-400 sm:mt-0 sm:shrink-0">
                  {formatPeriod(item.startDate, item.endDate)}
                </span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-neutral-500">
                {item.description}
              </p>

              {item.project && (
                <a
                  href={item.project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-1 text-sm text-neutral-600 underline decoration-neutral-200 underline-offset-4 transition-colors hover:text-neutral-900 hover:decoration-neutral-900"
                >
                  {item.project.name}
                  <Icon name="mdi:arrow-top-right" class="size-3" />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16">
    <h2 class="mb-8 text-sm tracking-widest text-neutral-400 uppercase">
      Education
    </h2>

    <ul class="space-y-10">
      {
        educations.map(item => (
          <li class="flex items-start gap-4">
            <Picture
              src={item.logo}
              formats={["avif", "webp"]}
              alt={item.institution}
              width={44}
              height={44}
              loading="eager"
              fetchpriority="high"
              class="mt-0.5 size-11 shrink-0 rounded-xl object-contain ring-1 ring-neutral-200"
            />

            <div class="flex-1">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                <p class="font-semibold text-neutral-900">{item.institution}</p>
                <span class="text-sm text-neutral-400">
                  {formatPeriod(item.startDate, item.endDate)}
                </span>
              </div>

              <p class="mt-0.5 text-sm text-neutral-500">{item.degree}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
