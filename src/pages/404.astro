---
import { useTranslations, type Locale } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";

const t = useTranslations((Astro.currentLocale ?? "en") as Locale);
---

<BaseLayout title="404 — Not Found">
  <div
    class="flex min-h-[60vh] flex-col items-center justify-center text-center"
  >
    <p class="text-border text-8xl font-bold sm:text-9xl">404</p>
    <h1 class="text-foreground mt-4 text-2xl font-semibold sm:text-3xl">
      {t.notFound.title}
    </h1>
    <p class="text-muted-foreground mt-3">
      {t.notFound.description}
    </p>
    <a
      href="/"
      class="text-subtle-foreground decoration-border hover:text-foreground hover:decoration-foreground mt-8 text-sm underline decoration-dashed underline-offset-4 transition-colors"
    >
      {t.notFound.backToHome}
    </a>
  </div>
</BaseLayout>
