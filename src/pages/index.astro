---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import avatar from "../assets/avatar.jpg";
import { Icon } from "astro-icon/components";
import { formatPeriod } from "../utils/date";
import { experiences } from "../data/experience";
import { educations } from "../data/education";
import { skills } from "../data/skills";
import SectionHeading from "../components/SectionHeading.astro";
import { config } from "../config";
import { useTranslations } from "../i18n";
import type { Locale } from "../i18n";

const t = useTranslations((Astro.currentLocale ?? "en") as Locale);
---

<BaseLayout title="Home">
  <section class="flex flex-col items-start gap-10 sm:flex-row">
    <Picture
      src={avatar}
      formats={["avif", "webp"]}
      alt="Kittipod Lambangchang"
      loading="eager"
      fetchpriority="high"
      class="aspect-3/4 w-56 shrink-0 rounded-md object-cover"
    />

    <div class="flex flex-1 flex-col gap-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-semibold text-neutral-900 sm:text-3xl">
          Kittipod Lambangchang
        </h1>
        <p class="text-neutral-400">
          aka Kitton <span class="mx-1.5">·</span>
          {t.hero.subtitle}
        </p>
      </div>

      <div class="space-y-3 leading-relaxed text-neutral-500">
        <p>{t.hero.bio}</p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        {
          config.contacts.map(contact => (
            <a
              href={contact.href}
              class="flex items-center gap-2 text-neutral-400 transition-colors hover:text-neutral-900"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={contact.icon} class="size-5" />
              {contact.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="experience" class="mt-16">
    <SectionHeading>{t.section.experience}</SectionHeading>

    <ul class="mt-8 space-y-10">
      {
        experiences.map((item, index) => {
          const exp = t.exp[item.id as keyof typeof t.exp];
          return (
            <li class="relative flex items-start gap-4">
              <div
                class:list={[
                  "absolute top-0 left-5.5 w-px bg-neutral-200 sm:left-7",
                  index < experiences.length - 1 ? "-bottom-10" : "h-6",
                ]}
              />

              <Picture
                src={item.logo}
                formats={["avif", "webp"]}
                alt={exp.company}
                loading="eager"
                fetchpriority="high"
                class="relative z-10 mt-0.5 size-11 shrink-0 rounded-xl object-contain ring-1 ring-neutral-200 sm:size-14"
              />

              <div class="flex-1">
                <div class="sm:flex sm:items-start sm:justify-between sm:gap-4">
                  <div>
                    <p class="font-semibold text-neutral-900">{exp.role}</p>
                    <p class="mt-0.5 text-sm font-medium text-neutral-700">
                      {exp.company}
                    </p>
                  </div>
                  <span class="mt-0.5 block text-sm text-neutral-400 sm:mt-0 sm:shrink-0">
                    {formatPeriod(item.startDate, item.endDate)}
                  </span>
                </div>
                <p class="mt-3 text-sm leading-relaxed text-neutral-500">
                  {exp.description}
                </p>

                {item.project && (
                  <a
                    href={item.project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 inline-flex items-center gap-1 text-sm text-neutral-600 underline decoration-neutral-200 underline-offset-4 transition-colors hover:text-neutral-900 hover:decoration-neutral-900"
                  >
                    {item.project.name}
                    <Icon name="mdi:arrow-top-right" class="size-3" />
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section id="education" class="mt-16">
    <SectionHeading>{t.section.education}</SectionHeading>

    <ul class="mt-8 space-y-10">
      {
        educations.map(item => {
          const edu = t.edu[item.id as keyof typeof t.edu];
          return (
            <li class="flex items-start gap-4">
              <Picture
                src={item.logo}
                formats={["avif", "webp"]}
                alt={edu.institution}
                class="mt-0.5 size-11 shrink-0 rounded-xl object-contain ring-1 ring-neutral-200 sm:size-14"
              />

              <div class="flex-1">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                  <p class="font-semibold text-neutral-900">
                    {edu.institution}
                  </p>
                  <span class="text-sm text-neutral-400">
                    {formatPeriod(item.startDate, item.endDate)}
                  </span>
                </div>

                <p class="mt-0.5 text-sm text-neutral-500">{edu.degree}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section id="skills" class="mt-16">
    <SectionHeading>{t.section.skills}</SectionHeading>

    <dl class="mt-8 space-y-5">
      {
        skills.map(group => (
          <div class="flex gap-4">
            <dt class="w-24 shrink-0 text-neutral-400">{group.category}</dt>
            <dd class="flex flex-wrap gap-x-4 gap-y-2">
              {group.items.map(skill => (
                <div class="flex items-center gap-1.5">
                  <Icon name={skill.icon} class="size-4" />
                  <span class="text-neutral-700">{skill.name}</span>
                </div>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>
