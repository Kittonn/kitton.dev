---
import type { CollectionEntry } from "astro:content";

type Props = {
  previousBlog: CollectionEntry<"blogs"> | null;
  nextBlog: CollectionEntry<"blogs"> | null;
};

const { previousBlog, nextBlog } = Astro.props;
---

<nav
  class="mt-14 flex items-start justify-between border-t border-neutral-100 pt-8"
>
  {
    previousBlog ? (
      <a
        href={`/blogs/${previousBlog.id}`}
        class="group max-w-[45%] space-y-1"
        aria-label={`Previous: ${previousBlog.data.title}`}
      >
        <span class="text-xs tracking-widest text-neutral-400 uppercase transition-colors group-hover:text-neutral-900">
          ← Prev
        </span>
        <p class="text-xs leading-relaxed text-neutral-400 transition-colors group-hover:text-neutral-900">
          {previousBlog.data.title}
        </p>
      </a>
    ) : (
      <span />
    )
  }
  {
    nextBlog ? (
      <a
        href={`/blogs/${nextBlog.id}`}
        class="group max-w-[45%] space-y-1 text-right"
        aria-label={`Next: ${nextBlog.data.title}`}
      >
        <span class="text-xs tracking-widest text-neutral-400 uppercase transition-colors group-hover:text-neutral-900">
          Next →
        </span>
        <p class="text-xs leading-relaxed text-neutral-400 transition-colors group-hover:text-neutral-900">
          {nextBlog.data.title}
        </p>
      </a>
    ) : (
      <span />
    )
  }
</nav>
