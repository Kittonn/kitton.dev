---
import { getSortedBlogs } from "../../utils/content";
import Pagination from "../../components/Pagination.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
  const blogs = await getSortedBlogs();
  return paginate(blogs, { pageSize: 5 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout title="Blogs">
  <h1 class="mb-6 text-xs tracking-widest text-neutral-400 uppercase">
    All Blogs
  </h1>

  <ul class="space-y-8">
    {
      page.data.map(blog => (
        <li>
          <a href={`/blogs/${blog.id}`} class="group block space-y-1">
            <span class="text-sm text-neutral-900 transition-colors group-hover:text-neutral-500">
              {blog.data.title}
            </span>
            <span class="block text-xs text-neutral-400">
              {blog.data.publishedDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </span>
            <span class="block text-xs leading-relaxed text-neutral-400">
              {blog.data.description}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
  />
</BaseLayout>
