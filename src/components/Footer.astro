---
import { Icon } from "astro-icon/components";
import { contacts } from "../data/contacts";
import { useTranslations } from "../i18n";
import type { Locale } from "../i18n";

const t = useTranslations((Astro.currentLocale ?? "en") as Locale);
const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-3xl px-6 py-8">
  <div
    class="flex items-center justify-between border-t border-neutral-200 pt-6"
  >
    <p class="text-sm text-neutral-400">
      &copy; {year}
      {t.footer.author}
    </p>

    <div class="flex items-center gap-3">
      {
        contacts.map(contact => (
          <a
            href={contact.href}
            class="text-neutral-400 transition-colors hover:text-neutral-900"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={contact.label}
          >
            <Icon name={contact.icon} class="size-5" />
          </a>
        ))
      }
    </div>
  </div>
</footer>
