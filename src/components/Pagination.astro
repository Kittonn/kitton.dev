---
type Props = {
  currentPage: number;
  lastPage: number;
  prevUrl: string | undefined;
  nextUrl: string | undefined;
};

const { currentPage, lastPage, prevUrl, nextUrl } = Astro.props;
---

<nav aria-label="Pagination" class="mt-12 flex items-center justify-between">
  {
    prevUrl ? (
      <a
        href={prevUrl}
        class="text-xs tracking-widest text-neutral-400 uppercase transition-colors hover:text-neutral-900"
      >
        ← Prev
      </a>
    ) : (
      <span class="text-xs tracking-widest text-neutral-200 uppercase">
        ← Prev
      </span>
    )
  }
  <span class="text-xs text-neutral-300">{currentPage} / {lastPage}</span>
  {
    nextUrl ? (
      <a
        href={nextUrl}
        class="text-xs tracking-widest text-neutral-400 uppercase transition-colors hover:text-neutral-900"
      >
        Next →
      </a>
    ) : (
      <span class="text-xs tracking-widest text-neutral-200 uppercase">
        Next →
      </span>
    )
  }
</nav>
