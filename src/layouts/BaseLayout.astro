---
import "../styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { config } from "../config";

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<html lang={Astro.currentLocale ?? config.site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | {config.site.title}</title>

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />

    <ClientRouter />
  </head>

  <body class="bg-background text-foreground flex min-h-screen flex-col">
    <Header transition:persist />

    <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-8">
      <slot />
    </main>
    <Footer />

    <script>
      import "../scripts/theme";
    </script>
  </body>
</html>
