---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import avatar from "../assets/avatar.jpg";
import { Icon } from "astro-icon/components";
import { formatPeriod } from "../utils/date";
import { experiences } from "../data/experience";
import { educations } from "../data/education";
import { skills } from "../data/skills";
import SectionHeading from "../components/SectionHeading.astro";
---

<BaseLayout title="About">
  <section class="space-y-6">
    <div class="flex items-center gap-5">
      <Picture
        src={avatar}
        formats={["avif", "webp"]}
        alt="Kittipod Lambangchang"
        width={400}
        height={500}
        loading="eager"
        fetchpriority="high"
        class="size-20 shrink-0 rounded-full object-cover"
      />

      <div class="space-y-1">
        <h1 class="text-2xl font-semibold text-neutral-900 sm:text-3xl">
          Kittipod Lambangchang
        </h1>
        <p class="text-sm text-neutral-400">
          aka Kitton <span class="mx-1.5">·</span> Software Engineer
        </p>
      </div>
    </div>

    <div class="space-y-3 leading-relaxed text-neutral-500">
      <p>
        I'm a Software Engineer working in fintech, passionate about building
        scalable distributed systems and designing reliable software, with a
        strong interest in cloud computing and microservices. I love seeing my
        work make a real impact for the people who use it. In my free time, I
        research new tech stacks to continuously improve my engineering skills
        and apply them to my work.
      </p>
      <p>
        This blog is where I share things I learn, build, and discover along the
        way.
      </p>
    </div>
  </section>

  <section class="mt-16">
    <SectionHeading>Experience</SectionHeading>

    <ul class="mt-8 space-y-10">
      {
        experiences.map((item, index) => (
          <li class="relative flex items-start gap-4">
            <div
              class:list={[
                "absolute top-0 left-5.5 w-0.25 bg-neutral-200 sm:left-7",
                index < experiences.length - 1 ? "-bottom-10" : "h-6",
              ]}
            />

            <Picture
              src={item.logo}
              formats={["avif", "webp"]}
              alt={item.company}
              width={1000}
              height={1000}
              class="relative z-10 mt-0.5 size-11 shrink-0 rounded-xl object-contain ring-1 ring-neutral-200 sm:size-14"
            />

            <div class="flex-1">
              <div class="sm:flex sm:items-start sm:justify-between sm:gap-4">
                <div>
                  <p class="font-semibold text-neutral-900">{item.role}</p>
                  <p class="mt-0.5 text-sm font-medium text-neutral-700">
                    {item.company}
                  </p>
                </div>
                <span class="mt-0.5 block text-sm text-neutral-400 sm:mt-0 sm:shrink-0">
                  {formatPeriod(item.startDate, item.endDate)}
                </span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-neutral-500">
                {item.description}
              </p>

              {item.project && (
                <a
                  href={item.project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-1 text-sm text-neutral-600 underline decoration-neutral-200 underline-offset-4 transition-colors hover:text-neutral-900 hover:decoration-neutral-900"
                >
                  {item.project.name}
                  <Icon name="mdi:arrow-top-right" class="size-3" />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16">
    <SectionHeading>Education</SectionHeading>

    <ul class="mt-8 space-y-10">
      {
        educations.map(item => (
          <li class="flex items-start gap-4">
            <Picture
              src={item.logo}
              formats={["avif", "webp"]}
              alt={item.institution}
              width={1000}
              height={1000}
              loading="eager"
              fetchpriority="high"
              class="mt-0.5 size-11 shrink-0 rounded-xl object-contain ring-1 ring-neutral-200 sm:size-14"
            />

            <div class="flex-1">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                <p class="font-semibold text-neutral-900">{item.institution}</p>
                <span class="text-sm text-neutral-400">
                  {formatPeriod(item.startDate, item.endDate)}
                </span>
              </div>

              <p class="mt-0.5 text-sm text-neutral-500">{item.degree}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16">
    <SectionHeading>Skills</SectionHeading>

    <dl class="mt-8 space-y-5">
      {
        skills.map(group => (
          <div class="flex gap-4">
            <dt class="w-24 shrink-0 text-neutral-400">{group.category}</dt>
            <dd class="flex flex-wrap gap-x-4 gap-y-2">
              {group.items.map(skill => (
                <div class="flex items-center gap-1.5">
                  <Icon name={skill.icon} class="size-4" />
                  <span class="text-neutral-700">{skill.name}</span>
                </div>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>
