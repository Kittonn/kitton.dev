---
import BaseLayout from "../layouts/BaseLayout.astro";
import { config } from "../config";
---

<BaseLayout title="About">
  <section class="space-y-6 text-base leading-relaxed text-neutral-600">
    <h1 class="text-xs tracking-widest text-neutral-400 uppercase">About</h1>
    <p>
      Hi, I'm <span class="text-neutral-900">{config.site.author}</span>. {
        config.site.description
      }
    </p>
  </section>
</BaseLayout>
