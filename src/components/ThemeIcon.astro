---
import { Icon } from "astro-icon/components";

const THEMES = [
  {
    label: "Light",
    value: "light",
    icon: "lucide:sun",
  },
  {
    label: "Dark",
    value: "dark",
    icon: "lucide:moon",
  },
  {
    label: "System",
    value: "system",
    icon: "lucide:contrast",
  },
];
---

<div class="relative">
  <button
    id="theme-toggle"
    aria-label="Toggle theme"
    class="text-subtle-foreground hover:text-foreground flex items-center transition-all"
  >
    <Icon name="lucide:sun" class="light size-4.5 sm:size-6" />
    <Icon name="lucide:moon" class="moon hidden size-4.5 sm:size-6" />
    <Icon name="lucide:contrast" class="system hidden size-4.5 sm:size-6" />
  </button>

  <div
    id="theme-dropdown"
    class="border-border bg-card absolute top-8 right-0 hidden w-36 overflow-hidden rounded-xl border py-1 shadow-lg"
  >
    {
      THEMES.map(theme => (
        <button
          data-theme={theme.value}
          class="text-foreground-secondary hover:bg-muted flex w-full cursor-pointer items-center gap-2.5 border-0 bg-transparent px-3 py-2 text-sm transition-colors"
        >
          <Icon name={theme.icon} class="size-4 shrink-0" />
          {theme.label}
        </button>
      ))
    }
  </div>
</div>

<style>
  #theme-toggle {
    border: 0;
    background: none;
    cursor: pointer;
  }

  [data-theme].active {
    background-color: var(--muted);
  }
</style>
