---
import { config } from "../config";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";

  return currentPath.startsWith(href);
}
---

<header class="mx-auto w-full max-w-3xl px-6 py-6">
  <nav class="flex items-center gap-4 sm:gap-6">
    <a
      href="/"
      class:list={[
        "text-sm tracking-widest uppercase transition-colors",
        isActive("/")
          ? "text-neutral-900"
          : "text-neutral-400 hover:text-neutral-900",
      ]}
    >
      {config.site.title}
    </a>

    <span class="text-neutral-200 select-none">/</span>

    <ul class="flex items-center gap-4 sm:gap-6">
      {
        config.navigation.slice(1).map(({ href, name }) => (
          <li>
            <a
              href={href}
              class:list={[
                "text-sm tracking-widest uppercase transition-colors",
                isActive(href)
                  ? "text-neutral-900"
                  : "text-neutral-400 hover:text-neutral-900",
              ]}
            >
              {name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
