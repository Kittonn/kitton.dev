---
import { config } from "../config";
import { useTranslations } from "../i18n";
import type { Locale } from "../i18n";

const t = useTranslations((Astro.currentLocale ?? "en") as Locale);

type NavItem = {
  key: keyof typeof t.nav;
  href: string;
};

const navItems = [
  { key: "experience", href: "#experience" },
  { key: "education", href: "#education" },
  { key: "skills", href: "#skills" },
] satisfies NavItem[];
---

<header class="sticky top-0 z-1000 bg-stone-50/80 backdrop-blur-sm">
  <div class="mx-auto w-full max-w-3xl px-6 py-6">
    <nav class="flex items-center gap-3 sm:gap-6">
      <a
        href="/"
        class="text-xs tracking-widest text-neutral-900 uppercase transition-colors hover:text-neutral-500 sm:text-sm"
      >
        {config.site.title}
      </a>

      <span class="text-neutral-200 select-none">/</span>

      <ul class="flex items-center gap-3 sm:gap-6">
        {
          navItems.map(({ href, key }) => {
            const nav = t.nav[key];
            return (
              <li>
                <a
                  href={href}
                  class="text-xs tracking-wider text-neutral-400 uppercase transition-colors hover:text-neutral-900 sm:text-sm sm:tracking-widest"
                >
                  <span class="sm:hidden">{nav.short}</span>
                  <span class="hidden sm:inline">{nav.full}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
