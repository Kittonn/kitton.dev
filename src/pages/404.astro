---
import { useTranslations, type Locale } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";

const t = useTranslations((Astro.currentLocale ?? "en") as Locale);
---

<BaseLayout title="404 — Not Found">
  <div
    class="flex min-h-[60vh] flex-col items-center justify-center text-center"
  >
    <p
      class="text-8xl font-bold text-neutral-200 sm:text-9xl dark:text-neutral-700"
    >
      404
    </p>
    <h1
      class="mt-4 text-2xl font-semibold text-neutral-900 sm:text-3xl dark:text-neutral-100"
    >
      {t.notFound.title}
    </h1>
    <p class="mt-3 text-neutral-500 dark:text-neutral-400">
      {t.notFound.description}
    </p>
    <a
      href="/"
      class="mt-8 text-sm text-neutral-400 underline decoration-neutral-300 decoration-dashed underline-offset-4 transition-colors hover:text-neutral-900 hover:decoration-neutral-900 dark:text-neutral-500 dark:decoration-neutral-600 dark:hover:text-neutral-100 dark:hover:decoration-neutral-100"
    >
      {t.notFound.backToHome}
    </a>
  </div>
</BaseLayout>
