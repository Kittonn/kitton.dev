---
import { Icon } from "astro-icon/components";
import { config } from "../config";
import { useTranslations } from "../i18n";
import type { Locale } from "../i18n";

const { contacts } = config;
const t = useTranslations((Astro.currentLocale ?? "en") as Locale);
const year = new Date().getFullYear();

const iconMap: Record<string, string> = {
  GitHub: "mdi:github",
  LinkedIn: "mdi:linkedin",
  Email: "mdi:gmail",
};
---

<footer class="mx-auto w-full max-w-3xl px-6 py-8">
  <div class="border-border flex items-center justify-between border-t pt-6">
    <p class="text-subtle-foreground text-sm">
      &copy; {year}
      {t.footer.author}
    </p>

    <div class="flex items-center gap-3">
      {
        contacts.map(contact => (
          <a
            href={contact.url}
            class="text-subtle-foreground hover:text-foreground transition-colors"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={contact.name}
          >
            <Icon
              name={iconMap[contact.name]}
              class="size-5"
              aria-hidden="true"
            />
          </a>
        ))
      }
    </div>
  </div>
</footer>
